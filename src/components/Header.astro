---
import Fav from '../img/favicon.ico'
---

<header class="border-b border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-800/90 px-6 py-4 sticky top-0 z-50 backdrop-blur-sm">
  <div class="max-w-5xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-md bg-white dark:bg-zinc-700">
        <span class="text-lg font-bold text-black dark:text-white">
          <img src={Fav} alt="sooox">
        </span>
      </div>
      <a href="/" class="font-semibold text-zinc-900 dark:text-white">sooox.cc</a>
    </div>
    <nav class="hidden md:flex items-center gap-6">
      <a href="/" class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <a href="/#contact" class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Contact</a>
      <a href="/services" class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Services</a>
      <a href="/blog" class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Blog</a>
     <a
        href="https://git.sooox.cc/sooox"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors flex items-center gap-1"
      >
        <svg class="h-4 w-4" viewBox="0 0 128 128">
          <path fill="currentColor" d="M89.457 0C83.719 0 78.68 3.195 76.012 7.887h-7.176c-20.844 0-37.902 17.059-37.902 37.902v53.265c-4.691 2.672-7.883 7.709-7.883 13.443c0 8.488 6.977 15.471 15.465 15.471s15.465-6.982 15.465-15.471c0-5.738-3.199-10.775-7.887-13.443V87.027c0-12.645 10.094-22.738 22.742-22.738h7.176c2.668 4.688 7.707 7.883 13.445 7.883c8.484 0 15.465-6.98 15.465-15.465s-6.977-15.465-15.465-15.465c-5.738 0-10.777 3.195-13.445 7.883h-7.176c-8.515 0-16.396 2.849-22.742 7.639V45.789a22.62 22.62 0 0 1 22.742-22.738h7.176c2.668 4.688 7.707 7.883 13.445 7.883c8.488 0 15.465-6.98 15.465-15.465S97.945 0 89.457 0m0 9.098c3.574 0 6.367 2.797 6.367 6.371s-2.793 6.367-6.367 6.367a6.3 6.3 0 0 1-6.367-6.367a6.3 6.3 0 0 1 6.367-6.371m0 41.242c3.574 0 6.367 2.797 6.367 6.367a6.29 6.29 0 0 1-6.367 6.363a6.29 6.29 0 0 1-6.367-6.363a6.3 6.3 0 0 1 6.367-6.367m-50.941 55.793a6.3 6.3 0 0 1 6.363 6.367c0 3.574-2.797 6.371-6.363 6.371c-3.574 0-6.367-2.797-6.367-6.371s2.793-6.367 6.367-6.367"/>
        </svg>
        Git
      </a>
    </nav>
  </div>
</header>
